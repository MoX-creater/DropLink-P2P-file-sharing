# ─── Server ───────────────────────────────────────────────────────────────────
# Port the signaling server listens on.
PORT=3001

# ─── CORS / Origins ───────────────────────────────────────────────────────────
# Allowed origin for Express HTTP routes (CORS middleware).
CLIENT_ORIGIN=http://localhost:5173

# Allowed origins for WebSocket upgrade requests.
# Comma-separated list.
ALLOWED_ORIGINS=http://localhost:5173

# production: 
# CLIENT_ORIGIN=https://droplink.vercel.app
# ALLOWED_ORIGINS=https://droplink.vercel.app


# ─── Room TTL ─────────────────────────────────────────────────────────────────
# How long (ms) a single-peer room is kept alive waiting for a second peer.
# After this window the room is torn down and the waiting peer is notified.
# Default: 300000 (5 minutes)
ROOM_TTL_MS=300000

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Max join-room attempts (successful or not) per IP within the window.
# Default: 10
RATE_LIMIT_MAX_ATTEMPTS=10

# Sliding-window duration in ms.
# Default: 60000 (1 minute)
RATE_LIMIT_WINDOW_MS=60000

# ─── Logging ──────────────────────────────────────────────────────────────────
# Minimum log level: debug | info | warn | error
# Default: info
LOG_LEVEL=info
